// benchgraph graph Worker + Container (MODEL-9).
// Deployed by .github/workflows/benchgraph-graph.yml (job `deploy`) on push to
// main. See docs/benchgraph-graph.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "benchgraph-graph",
  "main": "src/index.js",
  "compatibility_date": "2026-05-01",
  "account_id": "43840d11c8c4586acdba8b048414900a",
  "workers_dev": false,
  // A Workers route, not a Custom Domain: the CI token has no DNS edit
  // permission. The route needs a proxied DNS record for graph.benchgraph.dev.
  "routes": [
    { "pattern": "graph.benchgraph.dev/graph/*", "zone_name": "benchgraph.dev" }
  ],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "GraphContainer",
      "image": "../Dockerfile",
      // The Dockerfile copies pipeline/benchgraph_graph.py from the repo root.
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  // Read by the Worker only; the container never holds R2 credentials.
  "r2_buckets": [{ "binding": "EXPORTS", "bucket_name": "benchgraph-graph-exports" }],
  "durable_objects": {
    "bindings": [{ "name": "GRAPH", "class_name": "GraphContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GraphContainer"] }],
  "vars": {
    // Base URL of the export CI uploads to R2 (manifest.json, nodes.json,
    // edges.json). The host is not real: the Worker intercepts the container's
    // requests to it (GraphContainer.outboundByHost) and serves them from the
    // EXPORTS R2 binding. Local dev overrides this in .dev.vars.
    "GRAPH_EXPORT_URL": "http://graph-export.internal/benchgraph-graph/latest",
    // The deployed version. CI overrides it per deploy with
    // `wrangler deploy --var BUILD_COMMIT:$GITHUB_SHA` (CLI vars are merged over
    // the config vars, so GRAPH_EXPORT_URL survives). The Durable Object rolls
    // the container whenever this changes, and the container reports it back as
    // `service_commit`. "dev" is the local-dev placeholder.
    "BUILD_COMMIT": "dev"
  }
}
