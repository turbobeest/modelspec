{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pipeline.build:*)",
      "Bash(python3 -m pipeline.build:*)",
      "Bash(./.venv/bin/python -m pipeline.build:*)",

      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(./.venv/bin/python -m pytest:*)",

      "Bash(ruff:*)",
      "Bash(python -m ruff:*)",
      "Bash(./.venv/bin/python -m ruff:*)",

      "Bash(python scripts/validate_pr.py:*)",
      "Bash(./.venv/bin/python scripts/validate_pr.py:*)",

      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh secret list:*)"
    ]
  }
}
