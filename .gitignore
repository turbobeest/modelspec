__pycache__/
*.pyc
.venv/
*.egg-info/
/dist/
/build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
web/dist/
web/node_modules/
*.log
/tmp/
.DS_Store

# CodeGraph index (local, not shared)
.codegraph/

# Personal Claude Code overrides (permissions, connector ids)
.claude/settings.local.json

# Firecrawl scrape cache (pricing pages, etc.)
.firecrawl/

# Scraped provider pages behind the evidence ledger. The ledger keeps the
# source URL and date for every score, so these are re-fetchable and are not
# vendored third-party content.
benchmarks/_census/ranking_evidence/raw/

# MODEL-10 curation watcher state and run output (cached in CI, not committed)
benchmarks/_curation/state/
benchmarks/_curation/reports/
benchmarks/_curation/drafts/

# Third-party Python packages generated by pywrangler.
api/worker/python_modules/

# Repository packages generated beside the Worker entry point by
# api/worker/vendor.py. The Worker never holds a second copy in git (MODEL-68).
api/worker/src/api/
api/worker/src/decision/
api/worker/src/pipeline/
api/worker/src/registry/
api/worker/src/schema/
# Wrangler's local state and cache, written by `wrangler dev`.
.wrangler/

# Chart screenshots a browser reader wrote into the checkout.
.playwright-mcp/
