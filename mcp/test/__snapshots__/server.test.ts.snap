                      },
                      {
                        "type": "number",
                      },
                      {
                        "format": "date",
                        "type": "string",
                      },
                      {
                        "type": "string",
                      },
                    ],
                  },
                  "type": "array",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "In",
            },
            "not_in": {
              "anyOf": [
                {
                  "items": {
                    "anyOf": [
                      {
                        "type": "boolean",
                      },
                      {
                        "type": "integer",
                      },
                      {
                        "type": "number",
                      },
                      {
                        "format": "date",
                        "type": "string",
                      },
                      {
                        "type": "string",
                      },
                    ],
                  },
                  "type": "array",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Not In",
            },
            "soft": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Soft",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
            },
            "unknown": {
              "anyOf": [
                {
                  "enum": [
                    "list",
                    "fail",
                    "pass",
                  ],
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Unknown",
            },
          },
          "required": [
            "facet",
          ],
          "title": "InSet",
          "type": "object",
        },
