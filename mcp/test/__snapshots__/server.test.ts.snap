              },
              "title": "Quality Flags",
              "type": "array",
            },
            "recency_weight": {
              "anyOf": [
                {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Recency Weight",
            },
            "record_id": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Record Id",
            },
            "requested_domain": {
              "anyOf": [
                {
                  "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)*$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Requested Domain",
            },
            "source": {
              "pattern": "^https?://\\S+$",
              "title": "Source",
              "type": "string",
            },
            "source_snapshot": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Source Snapshot",
            },
            "sub_category": {
              "anyOf": [
