            "url",
          ],
          "title": "CitedSource",
          "type": "object",
        },
        "Compare": {
          "additionalProperties": false,
          "description": "\`\`facet op value\`\`; the value may be \`\`model(<id>)\`\` or \`\`best(m)\`\` for a relative
condition.",
          "properties": {
            "facet": {
              "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)*$",
              "title": "Facet",
              "type": "string",
            },
            "op": {
              "enum": [
                "=",
                "!=",
                "<",
                "<=",
                ">",
                ">=",
              ],
              "title": "Op",
              "type": "string",
            },
            "qualifiers": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EvidenceQualifiers",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
            },
            "soft": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Soft",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
            },
            "unknown": {
              "anyOf": [
                {
                  "enum": [
                    "list",
                    "fail",
                    "pass",
                  ],
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Unknown",
            },
            "value": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModelRef",
                },
                {
                  "$ref": "#/$defs/BestRef",
                },
                {
                  "type": "boolean",
                },
                {
                  "type": "integer",
                },
                {
                  "type": "number",
                },
                {
                  "format": "date",
                  "type": "string",
                },
                {
                  "type": "string",
                },
              ],
              "title": "Value",
            },
          },
          "required": [
            "facet",
            "op",
            "value",
          ],
          "title": "Compare",
          "type": "object",
        },
