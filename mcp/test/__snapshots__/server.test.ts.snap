        "FeedbackPointer": {
          "additionalProperties": false,
          "description": "Where to say whether this answer held up. The same on every decision.

Added in 2.10 (MODEL-221), so that an agent holding an answer finds the
feedback endpoint without reading anything else. No key is needed.",
          "properties": {
            "cli": {
              "const": "modelspec feedback <decision_id> --rating <rating>",
              "default": "modelspec feedback <decision_id> --rating <rating>",
              "title": "Cli",
              "type": "string",
            },
            "endpoint": {
              "const": "https://api.modelspec.dev/v1/feedback",
              "default": "https://api.modelspec.dev/v1/feedback",
              "title": "Endpoint",
              "type": "string",
            },
            "method": {
              "const": "POST",
              "default": "POST",
              "title": "Method",
              "type": "string",
            },
            "ratings": {
