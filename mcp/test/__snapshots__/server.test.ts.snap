                  "type": "number",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Cost Per Task",
            },
            "effort": {
              "anyOf": [
                {
                  "pattern": "^[a-z0-9_-]+$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
