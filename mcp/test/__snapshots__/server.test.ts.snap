        "Objective": {
          "additionalProperties": false,
          "description": "Exactly one of \`\`max\`\`, \`\`min\`\`, \`\`lexicographic\`\`, \`\`weights\`\`, \`\`pareto\`\`.",
          "properties": {
            "lexicographic": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/$defs/LexStep",
                  },
                  "type": "array",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Lexicographic",
            },
            "max": {
              "anyOf": [
                {
                  "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)*$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Max",
            },
            "min": {
              "anyOf": [
                {
                  "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)*$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Min",
            },
            "pareto": {
              "anyOf": [
                {
                  "items": {
                    "pattern": "^-?[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)*$",
                    "type": "string",
                  },
                  "type": "array",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Pareto",
            },
            "qualifiers": {
              "patternProperties": {
                "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)*$": {
                  "$ref": "#/$defs/EvidenceQualifiers",
                },
              },
              "title": "Qualifiers",
              "type": "object",
            },
            "weights": {
              "anyOf": [
                {
                  "patternProperties": {
                    "^-?[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)*(/[a-z][a-z0-9_]*)?$": {
                      "anyOf": [
                        {
                          "type": "number",
                        },
                        {
                          "$ref": "#/$defs/Preference",
                        },
                      ],
                    },
                  },
                  "type": "object",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Weights",
            },
          },
          "title": "Objective",
          "type": "object",
        },
