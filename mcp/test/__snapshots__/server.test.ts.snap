            "refinement": {
              "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)*$",
              "title": "Refinement",
              "type": "string",
            },
          },
          "required": [
            "dimension",
            "refinement",
            "gain",
          ],
          "title": "RefinementGain",
          "type": "object",
        },
        "Relaxation": {
          "additionalProperties": false,
          "description": "The smallest change to one numeric cap or floor that admits a model. Added in 1.5.

\`\`condition\`\` is the spec's condition; \`\`relaxed\`\` is the same facet and
direction at \`\`value\`\`, in \`\`unit\`\`, the nearest value any excluded
candidate has; \`\`admits\`\` counts the models that then qualify.",
          "properties": {
            "admits": {
              "minimum": 1,
              "title": "Admits",
              "type": "integer",
            },
            "condition": {
              "title": "Condition",
              "type": "string",
            },
            "facet": {
              "title": "Facet",
              "type": "string",
            },
            "relaxed": {
              "title": "Relaxed",
              "type": "string",
            },
            "unit": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Unit",
            },
            "value": {
              "title": "Value",
              "type": "number",
            },
          },
          "required": [
            "condition",
            "relaxed",
            "facet",
            "value",
            "admits",
          ],
          "title": "Relaxation",
          "type": "object",
        },
        "Result": {
          "additionalProperties": false,
          "properties": {
            "contributions": {
              "items": {
                "$ref": "#/$defs/Contribution",
              },
              "title": "Contributions",
