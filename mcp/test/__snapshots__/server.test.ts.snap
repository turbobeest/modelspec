        "Estate": {
          "additionalProperties": false,
          "description": "What the caller holds, sent with the spec and never stored. Added in 2.3.

\`\`providers\`\` are provider IDs the caller has a key for, \`\`plans\`\` are
subscription plan IDs, \`\`devices\`\` are hardware SKU IDs. \`\`exhausted\`\` lists
providers or plans that cannot be used right now; an exhausted provider
takes its key and its plans with it.",
          "properties": {
            "devices": {
              "items": {
                "maxLength": 120,
                "minLength": 1,
                "type": "string",
              },
              "maxItems": 64,
              "title": "Devices",
              "type": "array",
            },
            "exhausted": {
              "items": {
                "maxLength": 120,
                "minLength": 1,
                "type": "string",
              },
              "maxItems": 64,
              "title": "Exhausted",
              "type": "array",
            },
            "plans": {
              "items": {
                "maxLength": 120,
                "minLength": 1,
                "type": "string",
              },
              "maxItems": 64,
              "title": "Plans",
              "type": "array",
            },
            "providers": {
              "items": {
                "maxLength": 120,
                "minLength": 1,
                "type": "string",
              },
              "maxItems": 64,
              "title": "Providers",
              "type": "array",
            },
          },
          "title": "Estate",
          "type": "object",
        },
