            "unit": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Unit",
            },
            "value": {
              "anyOf": [
                {
                  "type": "boolean",
                },
                {
                  "type": "integer",
                },
                {
                  "type": "number",
                },
                {
                  "format": "date",
