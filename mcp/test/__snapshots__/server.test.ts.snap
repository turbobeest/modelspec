            "unit": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Unit",
            },
            "value": {
              "title": "Value",
              "type": "number",
            },
            "version": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Version",
            },
          },
          "required": [
