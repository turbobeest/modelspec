                  "unreliable",
                  "trustworthy",
                  "untrustworthy",
                  "confusing",
                ],
                "type": "string",
              },
              "title": "Ratings",
              "type": "array",
            },
            "request_schema": {
              "const": "https://modelspec.dev/api/feedback/v1.schema.json",
              "default": "https://modelspec.dev/api/feedback/v1.schema.json",
              "title": "Request Schema",
              "type": "string",
            },
          },
          "title": "FeedbackPointer",
          "type": "object",
        },
