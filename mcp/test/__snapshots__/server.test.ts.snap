                      "tied": "#/$defs/TiedAnswer",
                    },
                    "propertyName": "kind",
                  },
                  "oneOf": [
                    {
                      "$ref": "#/$defs/SeparatedAnswer",
                    },
                    {
                      "$ref": "#/$defs/TiedAnswer",
                    },
                  ],
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
              "title": "Answer",
            },
            "bands": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Bands",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
