              },
              "title": "Number Origins",
              "type": "array",
            },
            "out_of_lineup": {
              "default": 0,
              "minimum": 0,
              "title": "Out Of Lineup",
              "type": "integer",
            },
            "reading": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Reading",
                },
                {
                  "type": "null",
                },
              ],
              "default": null,
            },
            "relax": {
              "items": {
                "type": "string",
              },
              "title": "Relax",
