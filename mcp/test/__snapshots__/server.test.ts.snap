        "InSet": {
          "additionalProperties": false,
          "description": "\`\`facet in {a, b}\`\` or \`\`facet not in {a, b}\`\`. Values are kept sorted and unique.",
          "properties": {
            "facet": {
              "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)*$",
