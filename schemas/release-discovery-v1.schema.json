{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelspec.dev/schemas/release-discovery-v1.schema.json",
  "title": "ModelSpec release discovery v1",
  "description": "A primary-source watcher discovery (MODEL-216). The same six fields as release-signal v1; the signal ID starts with watch: and first_seen_url is the lab or provider page that listed the model. A discovery is a trigger, never evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_name",
    "provider",
    "first_seen_url",
    "timestamp",
    "confidence",
    "signal_id"
  ],
  "properties": {
    "model_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "first_seen_url": {
      "type": "string",
      "maxLength": 300,
      "format": "uri",
      "pattern": "^https://",
      "not": {
        "pattern": "^https://([^/]*\\.)?(x\\.com|twitter\\.com|t\\.co)(/|$)"
      }
    },
    "timestamp": {
      "type": "string",
      "maxLength": 300,
      "format": "date-time"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "signal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^watch:[A-Za-z0-9._:-]{1,122}$"
    }
  }
}
