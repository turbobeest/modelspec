<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.modelspec.agent-scenarios</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>@@REPO@@/qa/run-subscription-job.sh</string>
		<string>scenarios</string>
		<string>--scheduled</string>
		<string>--state-dir</string>
		<string>@@STATE@@</string>
		<string>--max-runs-per-cli</string>
		<string>400</string>
	</array>
	<key>StandardErrorPath</key>
	<string>@@LOGS@@/modelspec-scenarios-subscriptions.log</string>
	<key>StandardOutPath</key>
	<string>@@LOGS@@/modelspec-scenarios-subscriptions.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>23</integer>
		<key>Weekday</key>
		<integer>2</integer>
	</dict>
</dict>
</plist>
