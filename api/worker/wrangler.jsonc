// The ModelSpec rank Worker (MODEL-68): POST /v1/rank on api.modelspec.dev.
//
// A Python Worker, because the acceptance criterion is a ranking byte-identical
// to `modelspec offline rank --json`. A port into another language cannot meet
// that: CPython and V8 already disagree by one ULP on `log10` for values in this
// catalogue, and the composite is rounded to two decimals after those terms are
// summed. So the Worker runs the repository's own `pipeline/ranking.py`, copied
// beside this entry point by `api/worker/vendor.py` at build time and never
// committed. See docs/rank-api.md.
//
// Production is deployed by .github/workflows/rank-api.yml (job `deploy`) on
// pushes to main only. The isolated staging environment has a separate,
// workflow_dispatch-only job. Do not deploy either environment by hand.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "modelspec-rank",
  "main": "src/entry.py",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  // Registry files are runtime data read by decision/registry.py, and so are
  // the hardware/ files, whose names are the device IDs `estate.devices` is
  // checked against (MODEL-203). The synonym table is the one file
  // pipeline/vocab_synonyms.json; other pipeline JSON stays out of the upload.
  // Python files under src/ are discovered automatically; non-Python files need
  // a module rule or Wrangler leaves them out of the upload.
  "rules": [
    { "type": "Data", "globs": ["registry/*.yaml", "hardware/*.yaml", "pipeline/vocab_synonyms.json"], "fallthrough": true }
  ],
  "account_id": "43840d11c8c4586acdba8b048414900a",
  "workers_dev": false,
  // A Workers route, not a Custom Domain: the CI token
  // (CLOUDFLARE_API_MODELSPEC_TOKEN) has Workers Routes:Edit on the
  // modelspec.dev zone and no DNS permission at all. The route needs a proxied
  // DNS record for api.modelspec.dev, which is already in place
  // (AAAA api -> 100::, proxied). See docs/rank-api.md.
  //
  // The whole host, not just `/v1/*`. A path outside the route has no origin —
  // `100::` is the discard prefix — so Cloudflare answers 522, which is
  // indistinguishable from the endpoint being down. The Worker already 404s
  // every path it does not serve, naming `/v1/health`, `/v1/rank` and
  // `/v1/policy-check`; widening
  // the route is what lets that honest answer reach the bare root. It also
  // removes a 522 the deploy's own smoke test hit and could not read
  // (MODEL-68 follow-up).
  "routes": [
    { "pattern": "api.modelspec.dev/*", "zone_name": "modelspec.dev" }
  ],
  // MODEL-80. The policy determinations reach the Worker through Workers KV and
  // through nothing else: they are the paid product and are never committed to
  // this repository (docs/business/decision-record.md §2.2).
  //
  // The namespace was created 2026-09-17 on the Sparks & Sawdust LLC account.
  // Binding it does not by itself publish anything: the store is empty until
  // someone holding the private enrichment checkout runs
  // api/worker/load_determinations.py, and `_entitlement()` in src/entry.py
  // grants the store to a funded key or an unlimited paid tier (MODEL-69).
  // Unfunded keys receive the public-export answer, labelled with
  // `determinations.included: false`.
  //
  // MODEL-69. ACCESS holds API-key records (stored under the SHA-256 of the
  // key, never the key) and per-key daily and per-minute counters. It is a
  // separate namespace from DETERMINATIONS on purpose: that one holds our
  // research and is only ever read; this one is written on every keyed call.
  //
  // The namespace was created 2026-09-18 on the Sparks & Sawdust LLC account.
  // ACCESS_ENFORCED is on (MODEL-96). Machine data requests need a key, bought
  // through Checkout and issued at claim (MODEL-73). Live keys are checked
  // against this store; `test_` keys use the synthetic rank sandbox.
  //
  // MODEL-221. A FEEDBACK namespace is deliberately NOT bound yet. It is its
  // own namespace, never ACCESS: feedback has its own retention, and wiping it
  // must never touch a key record. It is created and bound as part of the
  // launch Jamie signs off (docs/design/feedback-privacy.md).
  "kv_namespaces": [
    { "binding": "DETERMINATIONS", "id": "a73f33d391f74c3e88e45f47d8e50814" },
    { "binding": "ACCESS", "id": "ef86b7ce138d4891b3eb630cdd2ba4e5" }
  ],
  "observability": { "enabled": true },
  "vars": {
    // Where the published static export is read from. The Worker holds no data
    // of its own; it ranks the same JSON the sites and the CLI read.
    "EXPORT_ORIGIN": "https://modelspec.dev",
    // The deployed version, echoed back as `service_commit`. CI overrides it
    // per deploy with `wrangler deploy --var BUILD_COMMIT:$GITHUB_SHA` (CLI
    // vars are merged over the config vars, so EXPORT_ORIGIN survives), and the
    // smoke test refuses to pass until /v1/health reports the sha it pushed.
    // "dev" is the local-development placeholder.
    "BUILD_COMMIT": "dev",
    // MODEL-96. Access enforcement is live. A machine data request with no key
    // gets 401 missing_api_key naming where to buy one. Known keys are metered;
    // unknown or revoked keys are refused. The free decide page uses MODEL-292
    // visit tokens for decide and vocabulary; health and feedback stay keyless.
    // `test_` keys use the synthetic rank sandbox. Any value other than
    // "false", "0", "no", "off" or "" reads as ON. See docs/api-access.md.
    "ACCESS_ENFORCED": "true",
    // MODEL-292. Live: verified browser visits keep the decide page free.
    "VISIT_GATE_ENABLED": "true",
    "VISIT_DECIDE_DAY_LIMIT": "300",
    "VISIT_DECIDE_BURST_LIMIT": "30",
    "VISIT_VOCABULARY_DAY_LIMIT": "60",
    "VISIT_VOCABULARY_BURST_LIMIT": "10",
    // MODEL-248. Jamie enables only after both secrets and the Pages site key exist.
    "HUMAN_GATE_ENABLED": "false",
    // MODEL-73. Hosted Stripe Checkout and the webhook that records the entitlement.
    // MODEL-96. Checkout is open for plans and credit packs. Claim issues the
    // API key after payment. This flag gates Checkout only; webhook, claim and
    // rotation also serve earlier purchases, even if Checkout closes again.
    // Secrets (STRIPE_SECRET_KEY,
    // STRIPE_WEBHOOK_SECRET) are Wrangler secrets, never in this file. See
    // docs/billing.md.
    "BILLING_ENABLED": "true",
    // MODEL-241. Keyless browser visitors are metered under
    // HMAC-SHA256(VISITOR_HMAC_KEY, IP | UTC day), from src/visitor.py. The key
    // is a Wrangler secret, set per environment, never in this file:
    //   npx wrangler secret put VISITOR_HMAC_KEY
    //   npx wrangler secret put VISITOR_HMAC_KEY --env staging
    // Without it a keyless visitor gets no meter id and takes the paid path.
    // MODEL-113. Grok Bot release-signal intake. Keep this off until Jamie
    // creates the two Wrangler secrets and configures Grok Bot.
    "SIGNALS_ENABLED": "false",
    // MODEL-221. Feedback storage (POST /v1/feedback). Ships OFF: the endpoint
    // validates, rate-limits in memory and answers `not_recorded`, and writes
    // nothing anywhere. Turning it on is Jamie's call, after the privacy
    // statement covers it (docs/design/feedback-privacy.md, "Launch"). On also
    // needs a FEEDBACK KV namespace in kv_namespaces and the Wrangler secret
    // FEEDBACK_LIMIT_PEPPER; without either, the endpoint answers 503 rather
    // than storing unkeyed. Any value other than "false", "0", "no", "off" or
    // "" reads as ON.
    "FEEDBACK_ENABLED": "false",
    // MODEL-75. x402 prepaid credits / per-call 402. Independent of Stripe
    // (MODEL-73) and of ACCESS_ENFORCED. Ships OFF. Any value other than
    // "false", "0", "no", "off" or "" reads as ON. See docs/x402.md.
    // MODEL-333: on, Base mainnet. Roll back: docs/x402-mainnet-flip.md.
    "X402_ENABLED": "true",
    // Mainnet USDC on Base (eip155:8453). Off: Base Sepolia only. Flipping
    // this on without also setting X402_NETWORK / X402_ASSET / X402_PAY_TO
    // for mainnet is refused at request time, not silently remapped.
    "X402_MAINNET": "true",
    // CAIP-2 Base mainnet (MODEL-333). Inert while X402_ENABLED is off.
    // CDP facilitator table, read 2026-09-18:
    // https://docs.cdp.coinbase.com/x402/seller/facilitator
    "X402_NETWORK": "eip155:8453",
    // Circle native USDC on Base. Source, read 2026-10-10:
    // https://developers.circle.com/stablecoins/usdc-contract-addresses
    "X402_ASSET": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
    // PLACEHOLDER: the zero address until Jamie supplies the LLC's Base mainnet
    // receiving address (MODEL-333). test_x402 refuses it while x402 is on.
    // EIP-55 checksummed. Address only, never a private key.
    "X402_PAY_TO": "0x0000000000000000000000000000000000000000",
    // Coinbase CDP facilitator origin. Paths /v2/x402/verify and /v2/x402/settle
    // are appended. https://docs.cdp.coinbase.com/api-reference/v2/rest-api/x402-facilitator/x402-facilitator
    "X402_FACILITATOR_URL": "https://api.cdp.coinbase.com/platform"
    // MODEL-88. Facilitator auth is Wrangler secrets, not vars:
    //   npx wrangler secret put CDP_API_KEY_ID
    //   npx wrangler secret put CDP_API_KEY_SECRET
    // The Worker mints a 2-minute JWT per facilitator call (method + host + path).
    // Docs, read 2026-09-18:
    // https://docs.cdp.coinbase.com/get-started/authentication/jwt-authentication
    // CDP_JWT is a local-testing override used only when those two secrets are
    // absent, and it is refused when X402_MAINNET is on.
  },
  // MODEL-75. One Durable Object for the credit ledger. Workers KV cannot
  // keep a balance non-negative under concurrent requests (no compare-and-set,
  // eventual consistency). The object is created by this migration on deploy;
  // there is no pre-created id to paste. Idle while X402_ENABLED is false.
  "durable_objects": {
    "bindings": [
      { "name": "CREDITS", "class_name": "CreditsObject" },
      // MODEL-248: new binding, reviewed and merged by Jamie. Idle with gate off.
      { "name": "HUMAN_GATE", "class_name": "HumanGateObject" }
    ]
  },
  "migrations": [
    { "tag": "v1-credits", "new_sqlite_classes": ["CreditsObject"] },
    { "tag": "v2-human-gate", "new_sqlite_classes": ["HumanGateObject"] }
  ],
  // MODEL-166 follow-up. Wrangler environments deploy as separate Workers;
  // `staging` therefore becomes modelspec-rank-staging. It has a workers.dev
  // URL and deliberately clears the production route. Bindings and vars are
  // non-inheritable and are repeated so no staging request can reach a
  // production store. Wrangler provisions the two id-less KV namespaces for
  // the staging Worker on its first manual deploy. Source, read 2026-09-26:
  // https://developers.cloudflare.com/workers/wrangler/configuration/#automatic-provisioning
  // https://developers.cloudflare.com/workers/wrangler/environments/#non-inheritable-keys-and-environments
  "env": {
    "staging": {
      "workers_dev": true,
      "routes": [],
      "kv_namespaces": [
        { "binding": "DETERMINATIONS" },
        { "binding": "ACCESS" }
      ],
      "vars": {
        "EXPORT_ORIGIN": "https://modelspec.dev",
        "BUILD_COMMIT": "dev",
        "ACCESS_ENFORCED": "false",
        // MODEL-292. Ships OFF; VISIT_TOKEN_HMAC_KEY is a new Wrangler secret.
        "VISIT_GATE_ENABLED": "false",
        "VISIT_DECIDE_DAY_LIMIT": "300",
        "VISIT_DECIDE_BURST_LIMIT": "30",
        "VISIT_VOCABULARY_DAY_LIMIT": "60",
        "VISIT_VOCABULARY_BURST_LIMIT": "10",
        // MODEL-248. Staging-only: verify the gate on Cloudflare before production.
        "HUMAN_GATE_ENABLED": "true",
        "BILLING_ENABLED": "false",
        "FEEDBACK_ENABLED": "false",
        "X402_ENABLED": "true",
        "X402_MAINNET": "false",
        "X402_NETWORK": "eip155:84532",
        "X402_ASSET": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
        "X402_PAY_TO": "0x1e62c42388271C68ce55e7E39d85912ACB918529",
        "X402_FACILITATOR_URL": "https://api.cdp.coinbase.com/platform"
      },
      "durable_objects": {
        "bindings": [
          { "name": "CREDITS", "class_name": "CreditsObject" },
          // MODEL-248: isolated staging namespace.
          { "name": "HUMAN_GATE", "class_name": "HumanGateObject" }
        ]
      }
    }
  }
}
